          "content": [
            {
              "type": "text",
              "content": "Role of Chat GPT in Public Health"
            }
          ],
          "level": 1
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.092,
            0.175,
            0.219,
            0.191
          ],
